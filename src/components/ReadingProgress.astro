---
// ReadingProgress.astro: Displays a celestial progress bar at the top of the viewport
---

<div
    id="reading-progress-container"
    class="fixed top-0 left-0 right-0 z-50 h-[3px] bg-indigo-950/60 pointer-events-none"
    aria-hidden="true"
>
    <div
        id="reading-progress-bar"
        class="h-full w-0 bg-gradient-to-r from-indigo-500 via-indigo-400 to-cyan-300 shadow-[0_0_12px_rgba(56,189,248,0.9)] transition-all duration-75 ease-out"
    >
    </div>
</div>

<script>
    function updateProgress() {
        const progressBar = document.getElementById("reading-progress-bar");
        if (!progressBar) return;

        const article = document.querySelector("article");
        if (!article) {
            progressBar.style.width = "0%";
            return;
        }

        const rect = article.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        const currentScroll = window.scrollY;
        const docHeight = document.documentElement.scrollHeight;

        // Check if user has reached bottom of document or end of article
        const isAtDocBottom = currentScroll + windowHeight >= docHeight - 12;
        const isAtArticleEnd = rect.bottom <= windowHeight + 80;

        if (isAtDocBottom || isAtArticleEnd) {
            progressBar.style.width = "100%";
            return;
        }

        const articleTop = rect.top + currentScroll;
        const articleHeight = rect.height;
        const start = Math.max(0, articleTop - 100);
        const end = articleTop + articleHeight - windowHeight;

        if (currentScroll <= start) {
            progressBar.style.width = "0%";
        } else if (end <= start) {
            progressBar.style.width = "100%";
        } else {
            const percent = ((currentScroll - start) / (end - start)) * 100;
            progressBar.style.width = `${Math.min(100, Math.max(0, Math.round(percent)))}%`;
        }
    }

    window.addEventListener("scroll", updateProgress, { passive: true });
    window.addEventListener("resize", updateProgress);
    window.addEventListener("load", updateProgress);
    document.addEventListener("DOMContentLoaded", updateProgress);
</script>



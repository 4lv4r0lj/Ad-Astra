---
// ImageLightbox.astro: Displays enlarged image in a modal with blurred backdrop
---

<div
    id="image-lightbox"
    class="fixed inset-0 z-50 hidden cursor-zoom-out items-center justify-center bg-black/75 p-4 backdrop-blur-md transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
    aria-label="Image preview"
>
    <button
        id="lightbox-close"
        type="button"
        class="absolute right-4 top-4 z-10 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-white/10 text-2xl font-bold text-white transition hover:bg-white/20 focus:outline-none"
        aria-label="Close image preview"
    >
        &times;
    </button>
    <figure
        class="relative flex max-h-full max-w-full flex-col items-center justify-center"
    >
        <img
            id="lightbox-img"
            src=""
            alt=""
            class="max-h-[88vh] max-w-[92vw] rounded-lg object-contain shadow-2xl transition-all duration-200"
        />
        <figcaption
            id="lightbox-caption"
            class="mt-3 max-w-[90vw] text-center font-404 text-sm text-gray-200 empty:hidden"
        >
        </figcaption>
    </figure>
</div>

<script>
    function setupImageLightbox() {
        const lightbox = document.getElementById("image-lightbox");
        const lightboxImg = document.getElementById(
            "lightbox-img",
        ) as HTMLImageElement | null;
        const lightboxCaption = document.getElementById("lightbox-caption");
        const closeBtn = document.getElementById("lightbox-close");

        if (!lightbox || !lightboxImg) return;

        let currentActiveImg: HTMLImageElement | null = null;

        function applyScale(naturalW: number, naturalH: number) {
            if (!lightboxImg || !naturalW || !naturalH) return;
            const maxViewportWidth = window.innerWidth * 0.92;
            const maxViewportHeight = window.innerHeight * 0.88;

            const scaleToFitWidth = maxViewportWidth / naturalW;
            const scaleToFitHeight = maxViewportHeight / naturalH;
            const maxScale = Math.min(scaleToFitWidth, scaleToFitHeight);

            // Scale up to 2.0x for smaller screenshots while respecting viewport boundaries
            const targetScale = maxScale >= 1 ? Math.min(maxScale, 2.0) : maxScale;
            const targetWidth = Math.round(naturalW * targetScale);
            const targetHeight = Math.round(naturalH * targetScale);

            lightboxImg.style.width = `${targetWidth}px`;
            lightboxImg.style.height = `${targetHeight}px`;
        }

        function openLightbox(img: HTMLImageElement) {
            if (!lightbox || !lightboxImg) return;
            currentActiveImg = img;
            lightboxImg.src = img.currentSrc || img.src;
            lightboxImg.alt = img.alt || "";

            const naturalW = img.naturalWidth || img.clientWidth;
            const naturalH = img.naturalHeight || img.clientHeight;
            if (naturalW && naturalH) {
                applyScale(naturalW, naturalH);
            }

            if (lightboxCaption) {
                lightboxCaption.textContent = img.alt || "";
            }
            lightbox.classList.remove("hidden");
            lightbox.classList.add("flex");
            document.body.classList.add("overflow-hidden");
        }

        function closeLightbox() {
            if (!lightbox || !lightboxImg) return;
            lightbox.classList.add("hidden");
            lightbox.classList.remove("flex");
            lightboxImg.src = "";
            lightboxImg.alt = "";
            lightboxImg.style.width = "";
            lightboxImg.style.height = "";
            currentActiveImg = null;
            if (lightboxCaption) {
                lightboxCaption.textContent = "";
            }
            document.body.classList.remove("overflow-hidden");
        }

        lightboxImg.onload = () => {
            if (lightboxImg && !lightbox.classList.contains("hidden")) {
                applyScale(
                    lightboxImg.naturalWidth,
                    lightboxImg.naturalHeight,
                );
            }
        };

        // Attach click listeners to all article images (both cover and markdown content)
        const article = document.querySelector("article");
        if (article) {
            const images = article.querySelectorAll("img");
            images.forEach((img) => {
                img.classList.add("cursor-zoom-in");
                img.addEventListener("click", () => openLightbox(img));
            });
        }

        lightbox.addEventListener("click", () => {
            closeLightbox();
        });

        closeBtn?.addEventListener("click", (e) => {
            e.stopPropagation();
            closeLightbox();
        });

        window.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !lightbox.classList.contains("hidden")) {
                closeLightbox();
            }
        });

        window.addEventListener("resize", () => {
            if (
                currentActiveImg &&
                !lightbox.classList.contains("hidden") &&
                lightboxImg
            ) {
                const naturalW =
                    lightboxImg.naturalWidth ||
                    currentActiveImg.naturalWidth ||
                    currentActiveImg.clientWidth;
                const naturalH =
                    lightboxImg.naturalHeight ||
                    currentActiveImg.naturalHeight ||
                    currentActiveImg.clientHeight;
                applyScale(naturalW, naturalH);
            }
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupImageLightbox);
    } else {
        setupImageLightbox();
    }
</script>


---
interface Props {
    href: string;
}

const { href } = Astro.props;
const { pathname } = Astro.url;

const cleanPath = pathname.replace(/\/$/, "") || "/";
const cleanHref = href.replace(/\/$/, "") || "/";
const isActive =
    cleanPath === cleanHref ||
    (cleanHref !== `${import.meta.env.BASE_URL}` &&
     cleanHref !== `${import.meta.env.BASE_URL}/` &&
     cleanHref !== "" &&
     cleanPath.startsWith(cleanHref));
---

<a
    class:list={[
        "font-header text-xl tracking-wide text-white underline-offset-8 transition-colors hover:text-cyan-300 hover:underline md:text-2xl",
        isActive ? "underline text-cyan-300" : "no-underline",
    ]}
    href={href}
>
    <slot />
</a>



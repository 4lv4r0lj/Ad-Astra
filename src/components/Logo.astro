---
import { Image } from "astro:assets";
import whiteLogo from "../assets/webp/white-logo.webp";
---

<a href={`${import.meta.env.BASE_URL}/`} class="flex justify-center my-2 transition-transform duration-300 hover:scale-[1.01]" aria-label="Ad Astra Home">
    <Image
        class="w-full max-w-5xl sm:object-top-crop md:w-4/6"
        src={whiteLogo}
        alt="Ad-Astra logo"
        loading="eager"
        fetchpriority="high"
    />
</a>




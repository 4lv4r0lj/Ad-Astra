---
import Layout from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");

interface TagCount {
    [key: string]: number;
}

const tagCount: TagCount = {};

posts.forEach((post) => {
    post.data.tags.forEach((tag) => {
        tagCount[tag] = (tagCount[tag] || 0) + 1;
    });
});

const tags = Object.entries(tagCount).sort((a, b) => {
    if (b[1] !== a[1]) return b[1] - a[1];
    return a[0].localeCompare(b[0]);
});
---

<Layout
    title="Tags - Ad Astra"
    description="Ad Astra, the first open-source, example-driven encyclopedia."
>
    <div
        class="mx-auto mt-8 flex w-full flex-col items-center font-404 text-white"
    >
        <h1 class="mb-8 text-4xl sm:text-5xl lg:text-6xl font-404">Tags</h1>
        <ul class="flex w-full flex-wrap justify-center gap-4">
            {
                tags.map(([tag, count]) => (
                    <li class="rounded-lg border-2 border-indigo-400/90 text-xl text-white shadow-md transition-all hover:border-cyan-400">
                        <a href={`${import.meta.env.BASE_URL}/tags/${tag}`} class="block px-4 py-2 text-white">
                            {tag} ({count})
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</Layout>



---
import Layout from "../layouts/Base.astro";
---

<Layout
    title="Ad Astra"
    description="Ad Astra, the first open-source, example-driven encyclopedia."
>
    <!-- Parent container -->
    <div class="mt-8 flex h-full flex-grow flex-col md:mt-0 md:flex-row">
        <!-- Text container -->
        <div
            class="flex flex-col justify-center text-white md:w-2/3"
        >
            <h1
                class="mb-8 text-center font-header text-3xl sm:text-4xl italic tracking-wide md:ml-12 md:text-left lg:text-5xl"
            >
                Ad Astra Per Aspera
            </h1>
            <p
                class="mx-4 sm:mx-10 mb-7 text-pretty font-404 text-lg font-light md:ml-12 md:text-xl lg:text-2xl"
            >
                Welcome to <strong class="text-white font-semibold">Ad Astra</strong>, the first <strong class="text-highlight">open-source, example-driven encyclopedia</strong>.
            </p>
            <p
                class="mx-4 sm:mx-10 text-pretty font-404 text-base sm:text-lg font-light text-slate-200 md:ml-12 md:text-xl"
            >
                This blog aims to provide <span class="text-highlight">comprehensive and accessible resources</span> for anyone looking to deepen their understanding. Each topic or concept presented is accompanied by one or more <span class="text-highlight">examples</span> for practical and direct learning.
            </p>
        </div>

        <!-- Rocket animation -->
        <div class="lg:max-w-sm xl:max-w-md">
            <dotlottie-player
                src={`${import.meta.env.BASE_URL}/rocket-dark.json`}
                speed="0.5"
                loop
                autoplay></dotlottie-player>
        </div>
    </div>
</Layout>

<script>
    import "@dotlottie/player-component";
</script>

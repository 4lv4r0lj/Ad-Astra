---
import { getCollection, type CollectionEntry } from "astro:content";
import type { Page, GetStaticPaths } from "astro";
import Layout from "../../layouts/Base.astro";
import PostPreview from "../../components/PostPreview.astro";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
    const posts = (await getCollection("posts")).sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
    );
    return paginate(posts, { pageSize: 6 });
};

type Props = {
    page: Page<CollectionEntry<"posts">>;
};

const page = Astro.props.page;
---

<Layout
    title="Ad Astra - All Blog Posts"
    description="Explore all blog posts in Ad Astra, the first open-source, example-driven encyclopedia."
>
    <div
        class="mt-8 flex h-fit flex-col items-center gap-6 font-404 text-white"
    >
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-404">Posts</h1>
        <ul
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 w-full"
        >
            {
                page.data.map((post) => (
                    <li class="w-full">
                        <PostPreview post={post} />
                    </li>
                ))
            }
        </ul>

        <nav class="mt-6 flex items-center gap-4 text-base font-404">
            {
                page.currentPage > 1 && (
                    <a
                        href={`${import.meta.env.BASE_URL}/posts/${page.currentPage - 1}`}
                        class="text-indigo-400 hover:text-cyan-300 transition-colors"
                    >
                        &lt; Previous
                    </a>
                )
            }
            <span class="rounded-lg border border-indigo-400/40 bg-indigo-950/30 px-3 py-1 text-sm text-gray-300">
                {page.currentPage} / {page.lastPage}
            </span>
            {
                page.currentPage < page.lastPage && (
                    <a
                        href={`${import.meta.env.BASE_URL}/posts/${page.currentPage + 1}`}
                        class="text-indigo-400 hover:text-cyan-300 transition-colors"
                    >
                        Next &gt;
                    </a>
                )
            }
        </nav>
    </div>
</Layout>

